{
  "name": "ESP8266 RTOS SDK Devcontainer",
  "image": "wifi-moisture-sensor-dev",

  "remoteUser": "vscode",

  "platform": "linux/amd64",
  "runArgs": ["--platform=linux/amd64"],

  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "remoteEnv": {
    "IDF_PATH": "/workspaces/${localWorkspaceFolderBasename}/Deps/ESP8266_RTOS_SDK"
  },

"postCreateCommand": "git submodule update --init Deps/ESP8266_RTOS_SDK && cd $IDF_PATH && git submodule update --init components/coap/libcoap && cd components/coap/libcoap && git config -f .gitmodules submodule.ext/tinydtls.url https://github.com/eclipse-tinydtls/tinydtls.git && git submodule sync --recursive && git submodule update --init --recursive ext/tinydtls && python -m pip install --user -r $IDF_PATH/requirements.txt",

  "customizations": {
    "vscode": {
      "settings": {
        "cmake.configureOnOpen": true,
        "cmake.generator": "Unix Makefiles",

        // optional: force single job builds (instead of your top-level field)
        "cmake.buildArgs": ["--", "-j1"],

        // ensure CMake sees IDF_PATH
        "cmake.configureEnvironment": {
          "IDF_PATH": "/workspaces/${localWorkspaceFolderBasename}/Deps/ESP8266_RTOS_SDK"
        },

        "terminal.integrated.defaultProfile.linux": "bash",
        "C_Cpp.intelliSenseEngineFallback": "Disabled"
      },
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "ms-vscode.cmake-tools",
        "ms-python.python",
        "IBM.output-colorizer",
        "ELF-Ripper-DevTeam.elf-ripper"
      ]
    }
  }
}
